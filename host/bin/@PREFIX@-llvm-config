SCRIPT_PATH="${BASH_SOURCE[0]}"
SCRIPT_PATH="$(readlink -f "$SCRIPT_PATH")"

if [ -x "$(command -v "${LLVM_CONFIG}")" ]; then
    LLVM_CONFIG="$(readlink -f "$LLVM_CONFIG")"
    if [ "$LLVM_CONFIG" != "$SCRIPT_PATH" ]; then
	exec "${LLVM_CONFIG}" "$@"
    fi
fi

CANDIDATES=()
for VER in {30..15}; do
    CANDIDATES+=("llvm-config-${VER}")
done
CANDIDATES+=("llvm-config"
             "/opt/homebrew/opt/llvm/bin/llvm-config"
             "/usr/local/opt/llvm/bin/llvm-config")

for CMD in "${CANDIDATES[@]}"; do
    if [ -x "$(command -v "${CMD}")" ]; then
	exec "${CMD}" "$@"
    fi
done

echo "error: no LLVM found, install LLVM 15 or newer with clang and lld, or set LLVM_CONFIG" >&2
exit 1
