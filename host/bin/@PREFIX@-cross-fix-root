SCRIPT_PATH="${BASH_SOURCE[0]}"
SCRIPT_NAME="$(basename "${SCRIPT_PATH}")"
SCRIPT_DIR="$(dirname "${SCRIPT_PATH}")"

@PLATFORM_UC@_PAYLOAD_SDK="$(realpath "${SCRIPT_DIR}/..")"
source "${@PLATFORM_UC@_PAYLOAD_SDK}/toolchain/@PREFIX@.sh"

if [[ -z $1 ]]; then
    WORKDIR="${@PLATFORM_UC@_SYSROOT}/${@PLATFORM_UC@_HBROOT}"
else
    WORKDIR=$1
fi

WORKDIR="$(realpath "${WORKDIR}")"

#
# Based on:
#  https://github.com/gentoo/crossdev/blob/master/wrappers/cross-fix-root
#

if [ -d "${WORKDIR}/lib" ]; then
    cd "${WORKDIR}/lib" || exit 1
    for FILENAME in $(find . -type f -name "lib*.la"); do
	echo "cross-fix-root: prepending sysroot to libdir in ${FILENAME}"
	sed -i.bak \
	    -e "/^libdir=/s:=.*:='${@PLATFORM_UC@_SYSROOT}${@PLATFORM_UC@_HBROOT}/lib':" \
	    -e "/^dependency_libs=/s: ${@PLATFORM_UC@_HBROOT}/lib/: ${@PLATFORM_UC@_SYSROOT}/${@PLATFORM_UC@_HBROOT}/lib/:g" \
            "${FILENAME}" || exit 1
	rm -f "${FILENAME}.bak"
    done
fi

if [ -d "${WORKDIR}/bin" ]; then
    cd "${WORKDIR}/bin" || exit 1
    for FILENAME in $(find . -type f -name "*-config"); do
	echo "cross-fix-root: prepending sysroot to prefix in ${FILENAME}"
	sed -i.bak "/^prefix=/s:=.*:='${@PLATFORM_UC@_SYSROOT}/${@PLATFORM_UC@_HBROOT}':" "${FILENAME}" || exit 1
	rm -f "${FILENAME}.bak"
    done
fi

